# Copy this file to .env and fill in real values. .env itself is gitignored.

# Source Postgres (e-commerce data)
SOURCE_POSTGRES_USER=
SOURCE_POSTGRES_PASSWORD=
SOURCE_POSTGRES_DB=
SOURCE_POSTGRES_PORT=5435

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Airflow metadata Postgres
AIRFLOW_POSTGRES_USER=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_POSTGRES_DB=

# Airflow admin user (created by airflow-init)
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
